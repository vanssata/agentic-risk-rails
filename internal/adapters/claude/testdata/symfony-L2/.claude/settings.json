{
  "permissions": {
    "deny": [
      "Edit(/riskrails.yaml)",
      "Edit(/**/riskrails.yaml)",
      "Edit(/.rr/**)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/.gemini/**)",
      "Edit(/.cursor/**)",
      "Edit(/.kiro/**)",
      "Edit(/.mcp.json)",
      "Edit(/**/.mcp.json)",
      "Edit(/.git/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.env*)",
      "Edit(/**/.env*)",
      "Edit(/config/secrets/**)",
      "Edit(/.git/config)",
      "Edit(/.git/refs/remotes/**)",
      "Edit(/.github/**)",
      "Edit(~/.config/riskrails/**)",
      "Edit(~/.cache/riskrails/**)",
      "Read(/.env.local)",
      "Read(/**/.env.local)",
      "Read(/.env.prod)",
      "Read(/**/.env.prod)",
      "Read(/config/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/riskrails/**)",
      "Read(~/.cache/riskrails/**)",
      "Bash(git push --force*)",
      "Bash(git push * main)",
      "Bash(rm -rf /)",
      "Bash(composer global *)",
      "Bash(php bin/console doctrine:schema:drop*)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(php bin/console doctrine:migrations:migrate*)",
      "Bash(composer require*)"
    ],
    "ask": [],
    "allow": [
      "Bash(composer install)",
      "Bash(php bin/phpunit*)",
      "Bash(php bin/console cache:clear)",
      "Bash(git status)",
      "Bash(git diff*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "rr guard --runtime claude --event PreToolUse",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        ".env.local",
        "**/.env.local",
        ".env.prod",
        "**/.env.prod",
        "config/secrets/**",
        "/home/test/.ssh/**",
        "/home/test/.aws/**",
        "/home/test/.config/riskrails/**",
        "/home/test/.cache/riskrails/**"
      ],
      "denyWrite": [
        "riskrails.yaml",
        "**/riskrails.yaml",
        ".rr/**",
        ".claude/**",
        ".codex/**",
        ".gemini/**",
        ".cursor/**",
        ".kiro/**",
        ".mcp.json",
        "**/.mcp.json",
        ".git/**",
        ".github/workflows/**",
        ".env*",
        "**/.env*",
        "config/secrets/**",
        ".git/config",
        ".git/refs/remotes/**",
        ".github/**",
        "/home/test/.config/riskrails/**",
        "/home/test/.cache/riskrails/**"
      ]
    }
  }
}
