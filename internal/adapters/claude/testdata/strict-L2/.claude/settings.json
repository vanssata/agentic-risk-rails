{
  "permissions": {
    "deny": [
      "Edit(/riskrails.yaml)",
      "Edit(/**/riskrails.yaml)",
      "Edit(/.rr/**)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/.gemini/**)",
      "Edit(/.cursor/**)",
      "Edit(/.kiro/**)",
      "Edit(/.mcp.json)",
      "Edit(/**/.mcp.json)",
      "Edit(/.git/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.env*)",
      "Edit(/**/.env*)",
      "Edit(/.git/config)",
      "Edit(/.git/refs/remotes/**)",
      "Edit(/.github/**)",
      "Edit(~/.config/riskrails/**)",
      "Edit(~/.cache/riskrails/**)",
      "Read(/.env*)",
      "Read(/**/.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/riskrails/**)",
      "Read(~/.cache/riskrails/**)",
      "Bash(git push --force*)",
      "Bash(rm -rf /)"
    ],
    "ask": [],
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "rr guard --runtime claude --event PreToolUse",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        ".env*",
        "**/.env*",
        "/home/test/.ssh/**",
        "/home/test/.aws/**",
        "/home/test/.config/riskrails/**",
        "/home/test/.cache/riskrails/**"
      ],
      "denyWrite": [
        "riskrails.yaml",
        "**/riskrails.yaml",
        ".rr/**",
        ".claude/**",
        ".codex/**",
        ".gemini/**",
        ".cursor/**",
        ".kiro/**",
        ".mcp.json",
        "**/.mcp.json",
        ".git/**",
        ".github/workflows/**",
        ".env*",
        "**/.env*",
        ".git/config",
        ".git/refs/remotes/**",
        ".github/**",
        "/home/test/.config/riskrails/**",
        "/home/test/.cache/riskrails/**"
      ]
    }
  }
}
