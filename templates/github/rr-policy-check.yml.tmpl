# Generated by `rr sync`. The job name is the required status check context.
#
# INVARIANT: pull_request_target runs THIS file from the base branch, so a PR
# cannot replace it (/.github/ is also code-owned). The PR head is checked out
# only as data: no build, install or script from the checkout is executed, and
# rr comes from a pinned release, never from the PR. Do not add steps that run
# checked-out code.
#
# RR_GITHUB_TOKEN: a token that may read org team membership (org members:read)
# and pull requests; the default GITHUB_TOKEN cannot read team membership.
# Approving after the check ran needs a re-run of this job.
name: rr-policy-check
on:
  pull_request_target:
    types: [opened, synchronize, reopened]
permissions:
  contents: read
  pull-requests: read
jobs:
  rr-policy-check:
    name: {{.Check}}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{.Checkout}} # v5
        with:
          ref: ${{"{{"}} github.event.pull_request.head.sha {{"}}"}}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-go@{{.SetupGo}} # v6
        with: { go-version: stable, cache: false }
      - run: go install github.com/vanssata/agentic-risk-rails/cmd/rr@{{.RR}}
        working-directory: ${{"{{"}} runner.temp {{"}}"}}
      - run: rr policy check --base origin/{{.Branch}} --pr ${{"{{"}} github.event.pull_request.number {{"}}"}}
        env:
          RR_GITHUB_TOKEN: ${{"{{"}} secrets.RR_GITHUB_TOKEN {{"}}"}}
