# Generated by `rr sync`.
name: rr-verify
on:
  pull_request:
{{- if .Nightly}}
  schedule:
    - cron: "17 2 * * *"
{{- end}}
permissions:
  contents: read
jobs:
  rr-verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{.Checkout}} # v5
        with: { fetch-depth: 0, persist-credentials: false } # the policy in force is read from origin/<default branch>
      - uses: actions/setup-go@{{.SetupGo}} # v6
        with: { go-version: "{{.GoVersion}}" }
      - run: go install github.com/vanssata/agentic-risk-rails/cmd/rr@{{.RR}}
        working-directory: ${{"{{"}} runner.temp {{"}}"}}
      - run: rr sync --check
      - run: rr verify --full
